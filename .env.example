# PayOps Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ── Database (Supabase session pooler — IPv4 compatible) ──────────────────────
PAYOPS_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres
PAYOPS_DB_USERNAME=postgres.hwreiftcsaprkuuwradh
PAYOPS_DB_PASSWORD=your-supabase-db-password-here

# ── JWT Secret (must be >= 64 characters of random text) ─────────────────────
# Generate one: https://generate.plus/en/base64?length=64
PAYOPS_JWT_SECRET=replace-this-with-a-64-plus-character-random-secret-string-here!!

# ── Optional overrides (defaults are fine for local dev) ─────────────────────
# FAKEBANK_URL=http://localhost:8081
# PAYOPS_JWT_EXPIRATION_MS=86400000
# PAYOPS_RECOVERY_INTERVAL_MS=5000
